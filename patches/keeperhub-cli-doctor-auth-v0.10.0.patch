@@ -180,18 +184,61 @@ func checkAuth(ctx context.Context, f *cmdutil.Factory) CheckResult {
 		return CheckResult{Status: "warn", Message: "not authenticated. Run: kh auth login"}
 	}
 	defer resp.Body.Close()
-	_, _ = io.Copy(io.Discard, resp.Body)
 
 	switch resp.StatusCode {
 	case http.StatusUnauthorized, http.StatusForbidden:
+		_, _ = io.Copy(io.Discard, resp.Body)
 		return CheckResult{Status: "warn", Message: "not authenticated. Run: kh auth login"}
 	case http.StatusOK:
+		if isAPIKey {
+			var payload struct {
+				Items []json.RawMessage `json:"items"`
+				Meta  json.RawMessage   `json:"meta"`
+				Links json.RawMessage   `json:"_links"`
+			}
+			if err := decodeSingleJSON(resp.Body, &payload); err != nil || payload.Items == nil {
+				return CheckResult{Status: "warn", Message: "could not verify auth status"}
+			}
+			return CheckResult{Status: "pass", Message: "authenticated (API key)"}
+		}
+
+		var payload struct {
+			User *struct {
+				ID string `json:"id"`
+			} `json:"user"`
+			Session *struct {
+				ID string `json:"id"`
+			} `json:"session"`
+		}
+		if err := decodeSingleJSON(resp.Body, &payload); err != nil ||
+			payload.User == nil || payload.User.ID == "" ||
+			payload.Session == nil || payload.Session.ID == "" {
+			return CheckResult{Status: "warn", Message: "not authenticated. Run: kh auth login"}
+		}
 		return CheckResult{Status: "pass", Message: "authenticated"}
 	default:
+		_, _ = io.Copy(io.Discard, resp.Body)
 		return CheckResult{Status: "warn", Message: "could not verify auth status"}
 	}
 }
 
+// decodeSingleJSON rejects empty, malformed, or multi-value response bodies.
+func decodeSingleJSON(r io.Reader, target any) error {
+	decoder := json.NewDecoder(r)
+	if err := decoder.Decode(target); err != nil {
+		return err
+	}
+
+	var extra json.RawMessage
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		if err == nil {
+			return errors.New("response contains multiple JSON values")
+		}
+		return err
+	}
+	return nil
+}
