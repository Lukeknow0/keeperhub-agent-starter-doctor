@@ -0,0 +1,195 @@
+package doctor
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/keeperhub/cli/internal/config"
+	khhttp "github.com/keeperhub/cli/internal/http"
+	"github.com/keeperhub/cli/pkg/cmdutil"
+	"github.com/keeperhub/cli/pkg/iostreams"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const (
+	testSessionToken = "session-test-token"
+	testAPIKey       = "kh_" + "test_api_key"
+	invalidAPIKey    = "kh_" + "invalid_api_key"
+	validSessionBody = `{"user":{"id":"user_test"},"session":{"id":"session_test","expiresAt":"2099-01-01T00:00:00Z","activeOrganizationId":"org_test"}}`
+	validAPIKeysBody = `{"items":[],"meta":{},"_links":{}}`
+)
+
+func newAuthCheckFactory(t *testing.T, serverURL, token string) *cmdutil.Factory {
+	t.Helper()
+	ios, _, _, _ := iostreams.Test()
+	return &cmdutil.Factory{
+		AppVersion: "1.2.3",
+		IOStreams:  ios,
+		Config: func() (config.Config, error) {
+			return config.Config{DefaultHost: serverURL}, nil
+		},
+		HTTPClient: func() (*khhttp.Client, error) {
+			return khhttp.NewClient(khhttp.ClientOptions{
+				Host:       serverURL,
+				Token:      token,
+				AppVersion: "1.2.3",
+				IOStreams:  ios,
+			}), nil
+		},
+	}
+}
+
+func TestCheckAuthValidSessionUsesFactoryCredentials(t *testing.T) {
+	t.Setenv("KH_API_KEY", "")
+
+	var gotPath, gotAuthorization string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		gotAuthorization = r.Header.Get("Authorization")
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(validSessionBody))
+	}))
+	defer server.Close()
+
+	result := checkAuth(context.Background(), newAuthCheckFactory(t, server.URL, testSessionToken))
+
+	require.Equal(t, "pass", result.Status)
+	assert.Equal(t, "authenticated", result.Message)
+	assert.Equal(t, "/api/auth/get-session", gotPath)
+	assert.Equal(t, "Bearer "+testSessionToken, gotAuthorization)
+}
+
+func TestCheckAuthRejectsInvalidSessionPayloads(t *testing.T) {
+	t.Setenv("KH_API_KEY", "")
+
+	tests := map[string]string{
+		"empty body":       ``,
+		"null":             `null`,
+		"empty object":     `{}`,
+		"empty array":      `[]`,
+		"empty string":     `""`,
+		"missing session":  `{"user":{"id":"user_test"}}`,
+		"missing user":     `{"session":{"id":"session_test"}}`,
+		"empty identity":   `{"user":{},"session":{}}`,
+		"malformed JSON":   `{"user":`,
+		"trailing JSON":    validSessionBody + `{}`,
+		"trailing garbage": validSessionBody + `not-json`,
+	}
+
+	for name, body := range tests {
+		t.Run(name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(body))
+			}))
+			defer server.Close()
+
+			result := checkAuth(context.Background(), newAuthCheckFactory(t, server.URL, testSessionToken))
+
+			assert.Equal(t, "warn", result.Status)
+			assert.NotEqual(t, "authenticated", result.Message)
+		})
+	}
+}
+
+func TestCheckAuthRejectsUnauthorizedSession(t *testing.T) {
+	t.Setenv("KH_API_KEY", "")
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusUnauthorized)
+	}))
+	defer server.Close()
+
+	result := checkAuth(context.Background(), newAuthCheckFactory(t, server.URL, "expired-"+testSessionToken))
+
+	assert.Equal(t, "warn", result.Status)
+	assert.Contains(t, result.Message, "not authenticated")
+}
+
+func TestCheckAuthValidAPIKeyUsesProtectedKeysEndpoint(t *testing.T) {
+	t.Setenv("KH_API_KEY", testAPIKey)
+
+	var gotPath, gotAuthorization string
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotPath = r.URL.Path
+		gotAuthorization = r.Header.Get("Authorization")
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(validAPIKeysBody))
+	}))
+	defer server.Close()
+
+	result := checkAuth(context.Background(), newAuthCheckFactory(t, server.URL, testAPIKey))
+
+	require.Equal(t, "pass", result.Status)
+	assert.Equal(t, "authenticated (API key)", result.Message)
+	assert.Equal(t, "/api/keys", gotPath)
+	assert.Equal(t, "Bearer "+testAPIKey, gotAuthorization)
+}
+
+func TestCheckAuthRejectsInvalidAPIKey(t *testing.T) {
+	t.Setenv("KH_API_KEY", invalidAPIKey)
+
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusUnauthorized)
+	}))
+	defer server.Close()
+
+	result := checkAuth(context.Background(), newAuthCheckFactory(t, server.URL, invalidAPIKey))
+
+	assert.Equal(t, "warn", result.Status)
+	assert.Contains(t, result.Message, "not authenticated")
+}
+
+func TestCheckAuthRejectsInvalidAPIKeyPayloads(t *testing.T) {
+	t.Setenv("KH_API_KEY", testAPIKey)
+
+	for name, body := range map[string]string{
+		"empty body":       ``,
+		"null":             `null`,
+		"empty object":     `{}`,
+		"empty array":      `[]`,
+		"empty string":     `""`,
+		"zero":             `0`,
+		"false":            `false`,
+		"missing items":    `{"meta":{},"_links":{}}`,
+		"null items":       `{"items":null,"meta":{},"_links":{}}`,
+		"items not array":  `{"items":{},"meta":{},"_links":{}}`,
+		"malformed JSON":   `[`,
+		"trailing JSON":    validAPIKeysBody + `[]`,
+		"trailing garbage": validAPIKeysBody + `not-json`,
+	} {
+		t.Run(name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(body))
+			}))
+			defer server.Close()
+
+			result := checkAuth(context.Background(), newAuthCheckFactory(t, server.URL, testAPIKey))
+
+			assert.Equal(t, "warn", result.Status)
+			assert.NotContains(t, result.Message, "authenticated")
+		})
+	}
+}
+
+func TestCheckAuthHonorsContextTimeout(t *testing.T) {
+	t.Setenv("KH_API_KEY", "")
+
+	server := httptest.NewServer(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
+		<-r.Context().Done()
+	}))
+	defer server.Close()
+
+	ctx, cancel := context.WithTimeout(context.Background(), 25*time.Millisecond)
+	defer cancel()
+
+	result := checkAuth(ctx, newAuthCheckFactory(t, server.URL, testSessionToken))
+
+	assert.Equal(t, "warn", result.Status)
+	assert.Equal(t, "auth check timed out", result.Message)
+}
